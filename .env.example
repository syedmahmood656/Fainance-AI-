# =====================================================================
# Telegram
# =====================================================================
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id(s), comma separated (ask @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=
# Leave EMPTY for local testing: the bot uses long-polling (no public URL / ngrok needed).
# Set to your public https URL in production: the webhook is registered automatically on startup.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# =====================================================================
# LLM providers - fill in ANY of them; the app tries them in this order
# and automatically falls through to the next model/provider on failure.
# =====================================================================
LLM_PROVIDER_ORDER=openrouter,gemini,huggingface

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# Leave empty to auto-use "openrouter/free" + whichever free models are available right now.
# Or pin your own list (tried in order), e.g.:
#   OPENROUTER_TEXT_MODELS=meta-llama/llama-3.3-70b-instruct:free,openrouter/free
#   OPENROUTER_VISION_MODELS=google/gemma-3-27b-it:free,openrouter/free
OPENROUTER_TEXT_MODELS=
OPENROUTER_VISION_MODELS=
OPENROUTER_DISCOVER_FREE_MODELS=true

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_VISION_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# --- Hugging Face (https://huggingface.co/settings/tokens, needs "Inference Providers" permission) ---
HUGGINGFACEHUB_API_TOKEN=
HF_TEXT_MODELS=Qwen/Qwen2.5-72B-Instruct,meta-llama/Llama-3.3-70B-Instruct
HF_VISION_MODELS=Qwen/Qwen2.5-VL-72B-Instruct

# Safety limits (these fix the "token limit" errors)
LLM_MAX_OUTPUT_TOKENS=1024
IMAGE_MAX_SIDE_PX=1280

# =====================================================================
# LangSmith (optional - leave the key empty to disable tracing)
# =====================================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=expense-tracker
# true = also hide message text (vendor names, amounts) in traces. Images are never sent.
LANGSMITH_REDACT_CONTENT=false

# =====================================================================
# Database & storage
# =====================================================================
# Docker: host is "db" (compose overrides this). Running locally: use localhost:5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/expense_db
RECEIPTS_DIR=receipts
REPORTS_TMP_DIR=reports_tmp
DEFAULT_CURRENCY=INR

# =====================================================================
# Reporting
# =====================================================================
# organization = reports cover every authorized user's confirmed expenses; user = only their own
REPORTS_SCOPE=organization
# true = reporting tools run through the MCP server; false = same functions called in-process (debugging)
USE_MCP=true
